<%layout("/layouts/boilerplate")%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
          <h3 class="mt-3">Edit your Listing</h3>
    <form action="/index/<%=list._id%>/update?_method=PATCH" method="post">
        
        <div class="mb-3">
         <label for="title" class="form-label"> Title :</label>
         <input type="text" id="title" name="title" value="<%=list.title%> " class="form-control">
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description :</label>
          <textarea name="description" id="description" class="form-control"><%=list.description%></textarea>
        </div>
        
        <div class="mb-3">
          <label for="image" class="form-label">Image-Link</label>
          <input type="text" name="listing[image]"  class="form-control" value="<%=list.image.url%>">
        </div>
        <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price"  class="form-label">Price :</label>
          <input type="text" id="price" name="price" value="<%=list.price%>" class="form-control">
        </div>
        <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country :</label>
        <input type="text" id="country" name="country" value="<%=list.country%>" class="form-control">
        </div>
        </div>
        <div class="mb3">    
        <label for="location"  class="form-label">Location :</label>
        <input type="text" id="location" name="location" value="<%=list.location%>" class="form-control">
        </div>
        <button class="btn btn-dark mb-3 mt-3 update-btn">Update</button>
    </form>
    </div>
    </div>
</body>
