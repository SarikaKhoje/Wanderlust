<%layout("/layouts/boilerplate")%>
<body>
    <h3>All Listing</h3>
    <!-- <form action="/index/create" method="get">
           <button>Add New</button>
    </form> -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <%for(let list of Lists ){ %>
    <a href="/index/<%=list._id%>/show" class="listing-link">
      <div class="card col">
      <img src="<%=list.image.url%>" class="card-img-top" alt="Listing Image" style="height:20rem;">
       <div class="card-img-overlay"></div>
      <div class="card-body">
      <p class="card-text">
        <p><b><%= list.title%></b></p>
        <p>Price : &#8377;<%= list.price.toLocaleString("en-IN") %>/night</p>
      </p>
  </div>

</div>
  </a>
<%}%>
</div>



