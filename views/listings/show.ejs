<% layout("/layouts/boilerplate")%>
<body>
   
    <div class="row">
        <div class="col-8 offset-3">
        <h3>Listing Details :</h3>
        </div>
        <div class="card show-card col-6 offset-3">
        <img src="<%= list.image.url%>" class="card-img-top show-img" alt="listing-image">
        <div class="card-body">
        <p class="card-text">
            <b><%=list.title%></b><br/>
            <%=list.description%><br/>
            &#8377;<%=list.price.toLocaleString("en-IN")%> <br/>
            <%=list.location%><br/>
            <%=list.country%>
        </p>
        <div class="btns">
       <form action="/index/<%=list._id%>/edit" method="get"><button class="btn btn-dark add-btn  ">Edit</button></form>
       <form action="/index/<%=list._id%>/DELETE?_method=DELETE" method="post"><button class="btn btn-dark">Delete</button></form>
    </div>
    </div>
    </div>
    
    </div>
</body>
