<%layout("/layouts/boilerplate")%>
<body>
    <div class="row">
    <div class="col-8 offset-2">
       
    <h3 class="mb-3 mt-4">Create a New Listing</h3>
    <form action="/index/create/new" method="post">
        <div class="mb-3">
            <label for="title" class="form-label"> Title :</label>
            <input type="text" id="title" name="title" class="form-control" placeholder="Add a catchytitle">
        
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description :</label>
            <textarea name="description" id="description" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Image-Link</label>
            <input type="text" name="listing[image]" placeholder="enter image URL/Link" class="form-control">
        </div>
        <div class="row">
        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price :</label>
            <input type="text" id="price" name="price" class="form-control" placeholder="1200">
        </div>
         <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country :</label>
            <input type="text" id="country" name="country" class="form-control" placeholder="India">
        </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location :</label>
            <input type="text" id="location" name="location" class="form-control" placeholder="Jaipur,Rajsthan">
        </div>
       
        <button class="btn btn-dark mb-3 add-btn">Add</button>
    </form>
    </div>
    </div>
</body>
